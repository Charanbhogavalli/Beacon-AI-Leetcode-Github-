{
  "name": "beacon-ai-server",
  "version": "1.0.0",
  "description": "Backend API service for Beacon AI Chrome Extension powered by Google Gemini",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/test_frontend.js && node test/test_api.js",
    "build:extension": "node node_modules/esbuild/bin/esbuild ../src/index.js --bundle --outfile=../content.js --format=iife"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "keywords": [
    "beacon",
    "gemini",
    "ai",
    "chrome-extension",
    "github",
    "leetcode"
  ],
  "author": "Beacon AI",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
