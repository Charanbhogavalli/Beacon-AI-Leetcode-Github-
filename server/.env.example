# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Default: 3001)
PORT=3001

# Preferred Gemini Model (Defaults to gemini-2.5-flash with fallbacks to gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origin (Default allows extension and localhost)
ALLOWED_ORIGIN=*
