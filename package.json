{
  "name": "beacon-ai",
  "version": "1.0.0",
  "description": "AI coding companion Chrome extension for GitHub and LeetCode powered by Google Gemini",
  "type": "module",
  "scripts": {
    "build": "node server/node_modules/esbuild/bin/esbuild src/index.js --bundle --outfile=content.js --format=iife",
    "watch": "node server/node_modules/esbuild/bin/esbuild src/index.js --bundle --outfile=content.js --format=iife --watch",
    "package": "npm run build && powershell -Command \"$ProgressPreference = 'SilentlyContinue'; Compress-Archive -Path manifest.json, background.js, content.js, content.css, icons, src -DestinationPath beacon-ai.zip -Force\"",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "test": "npm --prefix server test"
  },
  "main": "api/index.js",
  "dependencies": {
    "@google/genai": "^2.29.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "openai": "^7.45.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": [
    "beacon",
    "chrome-extension",
    "gemini",
    "github",
    "leetcode"
  ],
  "author": "Beacon AI",
  "license": "MIT"
}
